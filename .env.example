# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# ============================================================
# XAMPP MySQL Database (phpMyAdmin)
# 1. Start Apache + MySQL in XAMPP Control Panel
# 2. Open http://localhost/phpmyadmin
# 3. Import database/mn_tshirt_ecommerce.sql
# ============================================================
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=mn_tshirt_ecommerce
DB_PORT=3306

# Server
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# JWT
JWT_SECRET=your_jwt_secret_key_change_in_production
JWT_EXPIRY=7d

# KHQR Payment (ABA Pay / Bakong scan-to-pay)
# KHQR_ACCOUNT_ID is your Bakong Account ID / alias (looks like an email,
# e.g. yourname@ababkkh) - find it in the ABA app under your KHQR/merchant
# QR settings.
KHQR_ACCOUNT_ID=855965465944@aclb
KHQR_MERCHANT_NAME=CHHO SOTHEARO X EC
KHQR_MERCHANT_CITY=Phnom Penh

BAKONG_API_TOKEN=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJkYXRhIjp7ImlkIjoiM2I0YmY3YzIyZjg2NDJmZSJ9LCJpYXQiOjE3ODk2MjMwMDQsImV4cCI6MTc5NzM5OTAwNH0.yNoXhOD_h-zdH-DkNwJpVbJkxgQwVywgNs9vDZVNHOw

# ABA PayWay (Credit/Debit Card + a second PayWay-branded QR option)
# Get these from PayWay's sandbox approval email after registering for a
# sandbox merchant account at https://www.payway.com.kh. Leave blank until
# you have real values -- those payment options show a clear "not
# configured yet" error instead of crashing.
PAYWAY_MERCHANT_ID=
PAYWAY_PUBLIC_KEY=
PAYWAY_PURCHASE_URL=https://checkout-sandbox.payway.com.kh/api/payment-gateway/v1/payments/purchase
PAYWAY_CHECK_TRANSACTION_URL=https://checkout-sandbox.payway.com.kh/api/payment-gateway/v1/payments/check-transaction-2
PAYWAY_RETURN_URL=

